# FlashPass Environment Variables Template

# PostgreSQL Configuration
POSTGRES_USER=flashpass
POSTGRES_PASSWORD=flashpass_secret
POSTGRES_DB=flashpass
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgres://flashpass:flashpass_secret@localhost:5432/flashpass?sslmode=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=flashpass
RABBITMQ_PASSWORD=flashpass_secret
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://flashpass:flashpass_secret@localhost:5672/

# Server / App Configuration
PORT=8080
APP_ENV=development
